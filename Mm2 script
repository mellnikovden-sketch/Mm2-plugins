function createToggle(text, default, callback, order)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 44)
    container.BackgroundTransparency = 1
    container.LayoutOrder = order or 0
    container.Parent = scrollFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.65, -10, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = COLORS.TEXT
    label.TextSize = 18
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container

    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.new(0, 70, 0, 34)
    toggle.Position = UDim2.new(1, -80, 0.5, -17)
    toggle.BackgroundColor3 = default and COLORS.ACCENT or COLORS.BG
    toggle.BackgroundTransparency = 0.3
    toggle.Text = default and "ON" or "OFF"
    toggle.TextColor3 = COLORS.TEXT
    toggle.TextSize = 18
    toggle.Font = Enum.Font.GothamBold
    toggle.Parent = container
    local tcorner = Instance.new("UICorner")
    tcorner.CornerRadius = UDim.new(0, 8)
    tcorner.Parent = toggle

    local state = default or false
    local function toggleAction()
        state = not state
        toggle.Text = state and "ON" or "OFF"
        toggle.BackgroundColor3 = state and COLORS.ACCENT or COLORS.BG
        callback(state)
    end
    toggle.MouseButton1Click:Connect(toggleAction)
    toggle.TouchTap:Connect(toggleAction)
    return toggle
end

