--[[
    Spectre X - MM2 Script (Rayfield UI)
    Функции: Silent Aim (только убийца) + Wallcheck, ESP (сквозь стены), Chams, Auto Shoot, Auto Farm
    Загрузка Rayfield автоматическая.
--]]

-- Загружаем Rayfield (если уже загружен, пропускаем)
if not game:IsLoaded() then game.Loaded:Wait() end

local Rayfield = nil
if not getgenv().Rayfield then
    local RayfieldLib = loadstring(game:HttpGet('https://raw.githubusercontent.com/shlexware/Rayfield/main/source'))()
    getgenv().Rayfield = RayfieldLib
    Rayfield = RayfieldLib
else
    Rayfield = getgenv().Rayfield
end

-- Основные переменные
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Состояния
local silentAim = false
local wallcheck = false
local autoShoot = false
local espEnabled = false
local chamsEnabled = false
local farmEnabled = false

-- Ссылки на Remote (могут отличаться, проверьте в игре)
local shootRemote = ReplicatedStorage:FindFirstChild("Shoot") or ReplicatedStorage:FindFirstChild("Fire")
local collectCoinRemote = ReplicatedStorage:FindFirstChild("CollectCoin") or ReplicatedStorage:FindFirstChild("CoinCollected")

-- === Вспомогательные функции ===
local function getPlayerRole(player)
    if player.Character then
        for _, tool in pairs(player.Character:GetChildren()) do
            if tool:IsA("Tool") then
                local name = tool.Name:lower()
                if name:find("knife") or name:find("dagger") then
                    return "Murderer"
                elseif name:find("gun") or name:find("pistol") then
                    return "Sheriff"
                end
            end
        end
    end
    return "Innocent"
end

local function isVisible(targetPart)
    if not wallcheck then return true end
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin).Unit * 500
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    local result = workspace:Raycast(origin, direction, raycastParams)
    if result then
        local hit = result.Instance
        if hit and hit:IsDescendantOf(targetPart.Parent) then
            return true
        end
    end
    return false
end

local function getMurderer()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            if getPlayerRole(player) == "Murderer" then
                return player
            end
        end
    end
    return nil
end

-- === UI (Rayfield) ===
local Window = Rayfield:CreateWindow({
    Name = "Spectre X",
    Icon = 0, -- иконка (можно 0)
    LoadingTitle = "Spectre X Loading...",
    LoadingSubtitle = "by YourName",
    Theme = "Dark", -- или "Light"
    DisableBlur = false,
    Keybind = Enum.KeyCode.RightControl, -- закрыть/открыть
})

-- Вкладка Aimbot
