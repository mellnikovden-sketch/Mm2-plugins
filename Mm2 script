local chamsEnabled = false
local farmEnabled = false

-- Ссылки на удалённые события (названия могут меняться)
local shootRemote = ReplicatedStorage:FindFirstChild("Shoot") or ReplicatedStorage:FindFirstChild("Fire")
local collectCoinRemote = ReplicatedStorage:FindFirstChild("CollectCoin") or ReplicatedStorage:FindFirstChild("CoinCollected")

-- === Вспомогательные функции ===
local function getPlayerRole(player)
    -- Определяем роль по наличию инструментов
    if player.Character then
        local tools = player.Character:GetChildren()
        for _, tool in pairs(tools) do
            if tool:IsA("Tool") then
                if tool.Name:lower():find("knife") or tool.Name:lower():find("dagger") then
                    return "Murderer"
                elseif tool.Name:lower():find("gun") or tool.Name:lower():find("pistol") then
                    return "Sheriff"
                end
            end
        end
    end
    return "Innocent"
end

local function isVisible(targetPart)
    if not wallcheck then return true end
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin).Unit * 500
    local ray = Ray.new(origin, direction)
    local hit, position = workspace:FindPartOnRay(ray, LocalPlayer.Character)
    if hit then
        local part = hit.Parent
        if part and (part:IsDescendantOf(targetPart.Parent) or part == targetPart) then
            return true
        end
    end
    return false
end

local function getMurderer()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local role = getPlayerRole(player)
            if role == "Murderer" then
                return player
            end
        end
    end
    return nil
end

