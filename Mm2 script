        wallcheck = state
    end,
})

AimbotTab:CreateToggle({
    Name = "Auto Shoot",
    CurrentValue = false,
    Flag = "AutoShoot",
    Callback = function(state)
        autoShoot = state
    end,
})

-- Вкладка Visuals
local VisualsTab = Window:CreateTab("Visuals", 4483362458)

VisualsTab:CreateToggle({
    Name = "ESP (сквозь стены)",
    CurrentValue = false,
    Flag = "ESP",
    Callback = function(state)
