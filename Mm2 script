-- ========================
local espPlayers = false
local espTraps = false
local espGun = false
local autoShoot = false
local autoCoins = false
local shootOffset = 2.8

local highlightGroup = {}
local trapHighlights = {}
local gunHighlight = nil

function findMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            if p.Character and p.Character:FindFirstChild("Knife") then return p end
            if p.Backpack:FindFirstChild("Knife") then return p end
        end
    end
    return nil
end

function findSheriff()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            if p.Character and p.Character:FindFirstChild("Gun") then return p end
            if p.Backpack:FindFirstChild("Gun") then return p end
        end
    end
    return nil
end

function getNearestPlayer()
    local nearest, minDist = nil, math.huge
    if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return nil end
    local pos = LP.Character.HumanoidRootPart.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (pos - p.Character.HumanoidRootPart.Position).Magnitude
            if dist < minDist then
                minDist = dist
                nearest = p
            end
        end
    end
    return nearest
end

function refreshESP()
    for _, h in ipairs(highlightGroup) do h:Destroy() end
    highlightGroup = {}
    for _, h in ipairs(trapHighlights) do h:Destroy() end
    trapHighlights = {}
    if gunHighlight then gunHighlight:Destroy() gunHighlight = nil end

    if espPlayers then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local color, outline = COLORS.GREEN, COLORS.GREEN
                if p == findMurderer() then
                    color, outline = COLORS.RED, COLORS.RED
                elseif p == findSheriff() then
                    color, outline = COLORS.BLUE, COLORS.BLUE
                end
                local hl = Instance.new("Highlight")
                hl.Adornee = p.Character
                hl.FillColor = color
                hl.OutlineColor = outline
                hl.FillTransparency = 0.5
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = screenGui
                table.insert(highlightGroup, hl)
            end
        end
    end

    if espTraps then
        for _, trap in ipairs(workspace:GetDescendants()) do
            if trap.Name == "Trap" and trap:IsA("BasePart") then
                local hl = Instance.new("Highlight")
                hl.Adornee = trap
                hl.FillColor = Color3.fromRGB(255, 100, 0)
                hl.OutlineColor = Color3.fromRGB(255, 100, 0)
                hl.FillTransparency = 0.3
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = screenGui
                table.insert(trapHighlights, hl)
            end
        end
    end

    if espGun then
        local drop = workspace:FindFirstChild("GunDrop", true)
        if drop then
            local hl = Instance.new("Highlight")
            hl.Adornee = drop
            hl.FillColor = COLORS.ACCENT
            hl.OutlineColor = COLORS.ACCENT
            hl.FillTransparency = 0.2
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = screenGui
            gunHighlight = hl
        end
    end
end

-- Авто-выстрел
task.spawn(function()
    while task.wait(0.1) do
        if autoShoot and findSheriff() == LP then
            local murderer = findMurderer()
            if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
                local root = murderer.Character.HumanoidRootPart
                local vel = root.AssemblyLinearVelocity
                local pos = root.Position + vel * 0.2 + murderer.Character.Humanoid.MoveDirection * shootOffset
                local gun = LP.Character and LP.Character:FindFirstChild("Gun")
                if gun then
                    local shootEvent = gun:FindFirstChild("Shoot")
                    if shootEvent then
                        shootEvent:FireServer(
                            CFrame.new(gun.Parent.RightHand.Position),
                            CFrame.new(pos)
                        )
                    end
                end
            end
        end
    end
end)

-- Авто-сбор монет
task.spawn(function()
    while task.wait(0.5) do
        if not autoCoins then continue end
        local container = workspace:FindFirstChild("CoinContainer", true)
        if not container then continue end
        local coins = container:GetChildren()
        if #coins == 0 then continue end
        local nearest, minDist = nil, math.huge
        if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then continue end
        local pos = LP.Character.HumanoidRootPart.Position
        for _, coin in ipairs(coins) do
            if coin:IsA("BasePart") then
                local dist = (pos - coin.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearest = coin
                end
            end
        end
        if nearest then
            LP.Character.HumanoidRootPart.CFrame = CFrame.new(nearest.Position)
            task.wait(0.1)
        end
    end
end)

