    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(255,255,255)
    label.Font = Enum.Font.Gotham
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container

    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.new(0.25, 0, 1, 0)
    toggle.Position = UDim2.new(0.75, 0, 0, 0)
    toggle.BackgroundColor3 = default and Color3.fromRGB(0,200,0) or Color3.fromRGB(200,0,0)
    toggle.Text = default and "ON" or "OFF"
    toggle.TextColor3 = Color3.fromRGB(255,255,255)
    toggle.Font = Enum.Font.GothamBold
    toggle.TextSize = 12
    toggle.Parent = container
    local c = Instance.new("UICorner", toggle)
    c.CornerRadius = UDim.new(0, 4)

    local state = default
    toggle.MouseButton1Click:Connect(function()
        state = not state
        toggle.BackgroundColor3 = state and Color3.fromRGB(0,200,0) or Color3.fromRGB(200,0,0)
        toggle.Text = state and "ON" or "OFF"
        callback(state)
    end)
    return toggle, state
end

-- ---------- Настройки ----------
local settings = {
    esp = false,
    autoShoot = false,
    autoKnife = false,
    autoCoins = false,
    antiFling = false,
}

-- ---------- Вспомогательные функции ----------
local function findMurderer()
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= lp and pl.Character then
            if pl.Backpack:FindFirstChild("Knife") or pl.Character:FindFirstChild("Knife") then
                return pl
            end
        end
    end
    return nil
end

local function findSheriff()
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= lp and pl.Character then
            if pl.Backpack:FindFirstChild("Gun") or pl.Character:FindFirstChild("Gun") then
                return pl
            end
        end
    end
    return nil
end

local function findNearestPlayer()
    local nearest, minDist = nil, math.huge
    local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= lp and pl.Character then
            local other = pl.Character:FindFirstChild("HumanoidRootPart")
            if other then
                local dist = (hrp.Position - other.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearest = pl
                end
            end
        end
    end
    return nearest
end

local function getPredictedPosition(player, offset)
    offset = offset or 3.5
    local char = player.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return nil end
    local vel = hrp.AssemblyLinearVelocity
    local dir = hum.MoveDirection
    return hrp.Position + vel * 0.15 + dir * offset
end

-- ---------- Безопасный вызов Remote ----------
local function safeFireRemote(remote, ...)
    if not remote then return false end
    local success, err = pcall(function()
        if remote:IsA("RemoteEvent") then
            remote:FireServer(...)
        elseif remote:IsA("RemoteFunction") then
            remote:InvokeServer(...)
        end
    end)
    if not success then
        warn("[MM2] Remote call failed:", err)
        return false
    end
    return true
end

-- ---------- ESP (без изменений) ----------
local espObjects = {}
local function clearESP()
    for _, data in pairs(espObjects) do
        if data.highlight then data.highlight:Destroy() end
        if data.billboard then data.billboard:Destroy() end
    end
    espObjects = {}
end

local function updateESP()
    clearESP()
    if not settings.esp then return end

    local murderer = findMurderer()
    local sheriff = findSheriff()

    for _, pl in ipairs(Players:GetPlayers()) do
        if pl == lp then continue end
        if not pl.Character then continue end

        local highlight = Instance.new("Highlight")
        highlight.Adornee = pl.Character
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.6
        highlight.OutlineTransparency = 0.2

        local billboard = Instance.new("BillboardGui")
        billboard.Adornee = pl.Character:FindFirstChild("Head") or pl.Character:FindFirstChild("HumanoidRootPart")
        billboard.Size = UDim2.new(0, 100, 0, 30)
        billboard.AlwaysOnTop = true
        billboard.Parent = screenGui

        local label = Instance.new("TextLabel", billboard)
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextScaled = true
        label.Font = Enum.Font.GothamBold
        label.TextColor3 = Color3.fromRGB(255,255,255)
        label.TextStrokeTransparency = 0.3

        if pl == murderer then
            highlight.FillColor = Color3.fromRGB(255,0,0)
            highlight.OutlineColor = Color3.fromRGB(255,0,0)
            label.Text = "🔪 " .. pl.DisplayName
            label.TextColor3 = Color3.fromRGB(255,0,0)
        elseif pl == sheriff then
            highlight.FillColor = Color3.fromRGB(0,150,255)
            highlight.OutlineColor = Color3.fromRGB(0,150,255)
            label.Text = "🔫 " .. pl.DisplayName
            label.TextColor3 = Color3.fromRGB(0,150,255)
        else
            highlight.FillColor = Color3.fromRGB(0,255,0)
            highlight.OutlineColor = Color3.fromRGB(0,255,0)
            label.Text = pl.DisplayName
        end

        highlight.Parent = screenGui
        espObjects[pl] = {highlight = highlight, billboard = billboard}
    end
end

-- ---------- Авто-стрельба (шериф) ----------
local autoShootRunning = false
local autoShootConnection

local function startAutoShoot()
    if autoShootRunning then return end
    autoShootRunning = true
    autoShootConnection = RunService.Heartbeat:Connect(function()
        if not settings.autoShoot then
            autoShootRunning = false
            autoShootConnection:Disconnect()
            return
        end
        if findSheriff() ~= lp then return end
        local gun = lp.Character and lp.Character:FindFirstChild("Gun")
        if not gun then return end
        local murderer = findMurderer()
        if not murderer or not murderer.Character then return end
        local targetPos = getPredictedPosition(murderer, 3.5)
        if not targetPos then return end
        -- Проверка прямой видимости
        local origin = lp.Character.HumanoidRootPart.Position
        local dir = (targetPos - origin).Unit * 200
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {lp.Character}
        local hit = Workspace:Raycast(origin, dir, params)
        if hit and hit.Instance:IsDescendantOf(murderer.Character) then
            -- Ищем ремоут для стрельбы
            local shootRemote = gun:FindFirstChild("Shoot") or (gun:FindFirstChild("KnifeLocal") and gun.KnifeLocal:FindFirstChild("CreateBeam"))
            if shootRemote then
                local args = {1, targetPos, "AH2"}   -- стандартные аргументы для MM2
                safeFireRemote(shootRemote, unpack(args))
            end
        end
    end)
end

-- ---------- Автобросок ножа (убийца) ----------
local autoKnifeRunning = false
local autoKnifeConnection

local function startAutoKnife()
    if autoKnifeRunning then return end
    autoKnifeRunning = true
    autoKnifeConnection = RunService.Heartbeat:Connect(function()
        if not settings.autoKnife then
            autoKnifeRunning = false
            autoKnifeConnection:Disconnect()
            return
        end
        if findMurderer() ~= lp then return end
        local knife = lp.Character and lp.Character:FindFirstChild("Knife")
        if not knife then return end
        local target = findNearestPlayer()
        if not target or not target.Character then return end
        local targetPos = getPredictedPosition(target, 4)
        if not targetPos then return end
        -- Ищем ремоут для броска
        local throwRemote = knife:FindFirstChild("Throw") or (knife:FindFirstChild("Events") and knife.Events:FindFirstChild("KnifeThrown"))
        if throwRemote then
            local args = {
                CFrame.new(lp.Character.RightHand.Position),
                CFrame.new(targetPos)
            }
            safeFireRemote(throwRemote, unpack(args))
        end
    end)
end

-- ---------- Авто-сбор монет (без firetouchinterest) ----------
-- Вместо firetouchinterest мы просто телепортируемся на монету и ждём,
-- пока система сама засчитает сбор (обычно через TouchInterest).
-- Если этого недостаточно, можно попробовать вызвать RemoteEvent для сбора,
-- но я не знаю его названия. Альтернативно – просто телепорт и ожидание.
local coinLoop = nil

local function startCoinCollect()
    if coinLoop then return end
    coinLoop = RunService.Heartbeat:Connect(function()
        if not settings.autoCoins then
            coinLoop:Disconnect()
            coinLoop = nil
            return
        end
        local map = Workspace:FindFirstChild("Map") or Workspace:FindFirstChild("Lobby") and Workspace.Lobby:FindFirstChild("Map")
        if not map then return end
        local coinContainer = map:FindFirstChild("CoinContainer") or map:FindFirstChild("Coins")
        if not coinContainer then return end
        local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local nearest, minDist = nil, math.huge
        for _, child in ipairs(coinContainer:GetChildren()) do
            if child:IsA("Model") and child:FindFirstChild("Handle") then
                local pos = child:GetPivot().Position
                local dist = (hrp.Position - pos).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearest = child
                end
            end
        end
        if nearest then
            -- Телепортируемся прямо на монету
            hrp.CFrame = CFrame.new(nearest:GetPivot().Position + Vector3.new(0, 3, 0))
            task.wait(0.2)
            -- Пытаемся инициировать сбор через Touch (если не сработает, попробуем через Remote)
            local handle = nearest:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then
                -- Пытаемся использовать firetouchinterest, если он есть
                if firetouchinterest then
                    pcall(function()
                        firetouchinterest(hrp, handle, 0)
                        task.wait()
                        firetouchinterest(hrp, handle, 1)
                    end)
                else
                    -- Если firetouchinterest нет, просто остаёмся на месте – возможно, игра сама засчитает
                    -- Можно также попробовать найти RemoteEvent для сбора монеты
                end
            end
        end
    end)
end

-- ---------- Анти-флинг (без изменений) ----------
local antiFlingLastPos = Vector3.zero
local antiFlingConnection

local function startAntiFling()
    if antiFlingConnection then return end
    antiFlingConnection = RunService.Heartbeat:Connect(function()
        if not settings.antiFling then
            antiFlingConnection:Disconnect()
            antiFlingConnection = nil
            return
        end
        local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        if hrp.AssemblyLinearVelocity.Magnitude > 200 then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            if antiFlingLastPos ~= Vector3.zero then
                hrp.CFrame = CFrame.new(antiFlingLastPos)
            end
        else
            antiFlingLastPos = hrp.Position
        end
    end)
end

