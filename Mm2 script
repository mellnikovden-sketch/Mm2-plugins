--[[
    Скрипт Spectre для MM2
    Функции: Silent Aim, ESP, Auto Farm, Auto Shoot
    Запускайте с осторожностью!
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Создаём GUI
local ScreenGui = Instance.new("ScreenGui")
local Frame = Instance.new("Frame")
local Title = Instance.new("TextLabel")
local ToggleSA = Instance.new("TextButton")
local ToggleESP = Instance.new("TextButton")
local ToggleFarm = Instance.new("TextButton")
local ToggleShoot = Instance.new("TextButton")

ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
Frame.Parent = ScreenGui
Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Frame.Position = UDim2.new(0.8, 0, 0.2, 0)
Frame.Size = UDim2.new(0, 200, 0, 250)
Frame.Active = true
Frame.Draggable = true

Title.Parent = Frame
Title.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
Title.Size = UDim2.new(1, 0, 0, 30)
Title.Text = "Spectre v1.0"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextScaled = true

local function createButton(text, yPos)
    local btn = Instance.new("TextButton")
    btn.Parent = Frame
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.Position = UDim2.new(0.1, 0, 0, yPos)
    btn.Size = UDim2.new(0.8, 0, 0, 30)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextScaled = true
    return btn
end

local saBtn = createButton("Silent Aim: OFF", 40)
local espBtn = createButton("ESP: OFF", 80)
local farmBtn = createButton("Auto Farm: OFF", 120)
local shootBtn = createButton("Auto Shoot: OFF", 160)

-- Состояния
local silentAim = false
local espEnabled = false
local farmEnabled = false
local autoShoot = false

-- === Silent Aim ===
saBtn.MouseButton1Click:Connect(function()
    silentAim = not silentAim
    saBtn.Text = silentAim and "Silent Aim: ON" or "Silent Aim: OFF"
end)

RunService.RenderStepped:Connect(function()
    if silentAim then
        local target = nil
        local shortest = math.huge
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local pos, vis = Camera:WorldToScreenPoint(player.Character.HumanoidRootPart.Position)
                if vis then
                    local dist = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
                    if dist < shortest then
                        shortest = dist
                        target = player
                    end
                end
            end
        end
        if target and target.Character then
            -- Наводим камеру на цель (эмуляция Silent Aim)
            local targetPos = target.Character.HumanoidRootPart.Position
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
        end
    end
end)

-- === ESP ===
espBtn.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    espBtn.Text = espEnabled and "ESP: ON" or "ESP: OFF"
    if espEnabled then
        -- Создаём билборды для каждого игрока
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local bill = Instance.new("BillboardGui")
                bill.Name = "ESP_" .. player.Name
                bill.Parent = player.Character:WaitForChild("Head")
                bill.Size = UDim2.new(0, 50, 0, 30)
                bill.Adornee = player.Character.Head
                local label = Instance.new("TextLabel")
                label.Parent = bill
                label.Size = UDim2.new(1, 0, 1, 0)
                label.BackgroundTransparency = 1
                label.Text = player.Name .. "\n" .. (player:FindFirstChild("role") and player.role.Value or "?")
                label.TextColor3 = Color3.fromRGB(255, 0, 0)
                label.TextScaled = true
            end
        end
    else
        -- Удаляем все ESP
        for _, v in pairs(Players:GetPlayers()) do
            if v.Character and v.Character:FindFirstChild("Head") then
                local esp = v.Character.Head:FindFirstChild("ESP_" .. v.Name)
                if esp then esp:Destroy() end
            end
        end
    end
end)

-- === Auto Farm (сбор монет) ===
farmBtn.MouseButton1Click:Connect(function()
    farmEnabled = not farmEnabled
    farmBtn.Text = farmEnabled and "Auto Farm: ON" or "Auto Farm: OFF"
end)

RunService.RenderStepped:Connect(function()
    if farmEnabled then
        for _, v in pairs(workspace:GetChildren()) do
            if v:IsA("Part") and v.Name == "Coin" and v:FindFirstChild("Handle") then
                -- Имитация сбора: телепортируем игрока к монете (для демонстрации)
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = v.CFrame
                end
            end
        end
    end
end)

-- === Auto Shoot (стрельба по убийце) ===
shootBtn.MouseButton1Click:Connect(function()
    autoShoot = not autoShoot
    shootBtn.Text = autoShoot and "Auto Shoot: ON" or "Auto Shoot: OFF"
end)

RunService.RenderStepped:Connect(function()
    if autoShoot then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                -- Проверяем, является ли игрок убийцей (в MM2 есть значение в leaderstats)
                local role = player:FindFirstChild("role")
                if role and role.Value == "Murderer" then
                    -- Имитация выстрела (RemoteEvent обычно называется "Shoot")
                    local remote = game:GetService("ReplicatedStorage"):FindFirstChild("Shoot")
                    if remote then
                        remote:FireServer(player.Character.HumanoidRootPart.Position)
                    end
                end
            end
        end
    end
end)

print("Spectre loaded! Используйте GUI для управления.")
