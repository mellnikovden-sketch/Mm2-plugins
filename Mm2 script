-- Переключение вкладок
local function switchTab(tabName)
    for _, child in pairs(ContentFrame:GetChildren()) do
        if child:IsA("Frame") then
            child.Visible = (child.Name == tabName)
        end
    end
    for name, btn in pairs(tabButtons) do
        btn.BackgroundColor3 = (name == tabName) and Color3.fromRGB(70, 70, 120) or Color3.fromRGB(40, 40, 65)
        btn.TextColor3 = (name == tabName) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)
    end
    currentTab = tabName
    -- Обновляем размер Canvas
    task.wait(0.1)
    local maxHeight = 0
    for _, child in pairs(ContentFrame:GetChildren()) do
        if child:IsA("Frame") and child.Visible then
            local height = 0
            for _, c in pairs(child:GetChildren()) do
                if c:IsA("Frame") then
                    local pos = c.Position.Y.Offset
                    if pos + 50 > height then height = pos + 50 end
                end
            end
            if height > maxHeight then maxHeight = height end
        end
    end
    ContentFrame.CanvasSize = UDim2.new(0, 0, 0, maxHeight + 20)
end

for name, btn in pairs(tabButtons) do
    btn.MouseButton1Click:Connect(function()
        switchTab(name)
    end)
end
