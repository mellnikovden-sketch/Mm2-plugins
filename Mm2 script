-- MM2 Universal Menu Script
-- Нажмите [Insert] или [F5] чтобы открыть/закрыть меню

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("Murder Mystery 2 ❄ Universal", "DarkTheme")

-- ===== ВКЛАДКА "ИГРОК" =====
local PlayerTab = Window:NewTab("🎯 Игрок")
local PlayerSection = PlayerTab:NewSection("Настройки игрока")

-- Получение игрока
local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

-- Godmode
PlayerSection:NewToggle("🛡️ Режим Бога", "Неуязвимость для убийцы", function(state)
    if state then
        game:GetService("RunService").Stepped:Connect(function()
            if player.Character and player.Character:FindFirstChild("Humanoid") then
                player.Character.Humanoid.Health = 100
                player.Character.Humanoid.MaxHealth = 100
            end
        end)
    else
        -- Отключаем
    end
end)

-- Speed
PlayerSection:NewSlider("🏃‍♂️ Скорость", "Изменение скорости", 500, 16, 25, function(s)
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.WalkSpeed = s
    end
end)

-- Jump Power
PlayerSection:NewSlider("🦘 Сила прыжка", "Изменение высоты прыжка", 500, 50, 100, function(s)
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.JumpPower = s
    end
end)

-- Fly
PlayerSection:NewToggle("✈️ Полёт", "Возможность летать", function(state)
    if state then
        local fly = Instance.new("BodyVelocity")
        fly.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        fly.Velocity = Vector3.new(0, 0, 0)
        fly.Parent = player.Character.HumanoidRootPart
        
        game:GetService("RunService").Heartbeat:Connect(function()
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local move = player.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -5)
                local pos = player.Character.HumanoidRootPart.Position
                local target = pos + Vector3.new(0, 10, 0)
                player.Character.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
                player.Character.HumanoidRootPart.CFrame = CFrame.new(target)
            end
        end)
    end
end)

-- ===== ВКЛАДКА "ОРУЖИЕ" =====
local WeaponTab = Window:NewTab("🔫 Оружие")
local WeaponSection = WeaponTab:NewSection("Настройки оружия")

-- Получение оружия через инструменты
WeaponSection:NewToggle("🔪 Бесконечные ножи", "Бесконечный запас ножей", function(state)
    if state then
        game:GetService("RunService").Stepped:Connect(function()
            for _, tool in ipairs(player.Backpack:GetChildren()) do
                if tool:IsA("Tool") and tool.Name:find("Knife") then
                    tool:Clone().Parent = player.Backpack
                end
            end
        end)
    end
end)

-- Автоматический бросок ножа
WeaponSection:NewToggle("🎯 Авто-бросок", "Автоматически кидать ножи в игроков", function(state)
    if state then
        while state do
            game:GetService("RunService").Heartbeat:Wait()
            for _, plr in ipairs(game.Players:GetPlayers()) do
                if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    -- Симуляция броска
                    local tool = player.Character:FindFirstChildOfClass("Tool")
                    if tool and tool.Name:find("Knife") then
                        tool:Activate()
                        task.wait(0.1)
                    end
                end
            end
        end
    end
end)

-- ===== ВКЛАДКА "ВИЗУАЛ" =====
local VisualTab = Window:NewTab("👁️ Визуал")
local VisualSection = VisualTab:NewSection("Визуальные настройки")

-- ESP игроков
VisualSection:NewToggle("👤 ESP игроков", "Показывать игроков через стены", function(state)
    if state then
        for _, plr in ipairs(game.Players:GetPlayers()) do
            if plr ~= player and plr.Character then
                local highlight = Instance.new("Highlight")
                highlight.Parent = plr.Character
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                highlight.FillTransparency = 0.5
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            end
        end
    else
        for _, plr in ipairs(game.Players:GetPlayers()) do
            if plr.Character then
                for _, v in ipairs(plr.Character:GetChildren()) do
                    if v:IsA("Highlight") then
                        v:Destroy()
                    end
                end
            end
        end
    end
end)

-- Частицы
VisualSection:NewToggle("✨ Частицы за игроком", "След частиц", function(state)
    if state then
        local attachment = Instance.new("Attachment")
        attachment.Parent = player.Character.HumanoidRootPart
        
        local particle = Instance.new("ParticleEmitter")
        particle.Parent = attachment
        particle.Texture = "rbxassetid://420539122"
        particle.Rate = 50
        particle.Lifetime = NumberRange.new(1)
        particle.SpreadAngle = Vector2.new(360, 360)
        particle.VelocityInheritance = 0
    end
end)

-- ===== ВКЛАДКА "МИР" =====
local WorldTab = Window:NewTab("🌍 Мир")
local WorldSection = WorldTab:NewSection("Настройки мира")

-- Noclip
WorldSection:NewToggle("🚫 Noclip", "Проходить сквозь стены", function(state)
    if state then
        game:GetService("RunService").Stepped:Connect(function()
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                player.Character.HumanoidRootPart.CanCollide = false
            end
        end)
    else
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            player.Character.HumanoidRootPart.CanCollide = true
        end
    end
end)

-- Удаление тумана
WorldSection:NewToggle("🌫️ Убрать туман", "Убрать весь туман", function(state)
    if state then
        game.Lighting.FogEnd = 100000
        game.Lighting.FogStart = 0
    else
        game.Lighting.FogEnd = 500
        game.Lighting.FogStart = 0
    end
end)

-- Время суток
WorldSection:NewSlider("🌅 Время суток", "Изменить время (0-24)", 24, 0, 12, function(s)
    game.Lighting.ClockTime = s
end)

-- ===== ВКЛАДКА "РАЗНОЕ" =====
local MiscTab = Window:NewTab("⚙️ Разное")
local MiscSection = MiscTab:NewSection("Настройки")

-- Телепорт к игроку
MiscSection:NewButton("📍 Телепорт к игроку", "Выберите игрока из списка", function()
    local plrs = {}
    for _, v in ipairs(game.Players:GetPlayers()) do
        if v ~= player then
            table.insert(plrs, v.Name)
        end
    end
    local selected = game:GetService("GuiService"):GetGuiObjectAt(Vector2.new(0, 0))
    -- Упрощенная версия
    local target = game.Players:FindFirstChild(plrs[1])
    if target and target.Character then
        player.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame
    end
end)

-- Перезарядка игры
MiscSection:NewButton("🔄 Перезагрузить игру", "Перезапустить игру", function()
    game:GetService("TeleportService"):Teleport(game.PlaceId)
end)

-- ===== УПРАВЛЕНИЕ МЕНЮ =====
-- Открытие/закрытие по Insert или F5
game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed then
        if input.KeyCode == Enum.KeyCode.Insert or input.KeyCode == Enum.KeyCode.F5 then
            Library:Toggle()
        end
    end
end)

-- Защита от выключения
Library:Toggle()

print("✅ MM2 Universal Menu загружен!")
print("📌 Нажмите Insert или F5 для открытия/закрытия")
