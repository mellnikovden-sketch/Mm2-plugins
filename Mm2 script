--[[
    ============================================================================
    MM2 FULL SCRIPT (Server-side)
    Версия: 2.0
    Автор: AI Assistant
    Описание: Полноценный Murder Mystery 2 с автоматическим созданием RemoteEvents,
              ролями (убийца, шериф, невиновные), очками, таймерами и оружием.
    ============================================================================
--]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- ============================================================================
-- 1. АВТОМАТИЧЕСКОЕ СОЗДАНИЕ RemoteEvents (чтобы избежать ошибок)
-- ============================================================================
local function EnsureRemoteEvents()
    local remoteFolder = ReplicatedStorage:FindFirstChild("RemoteEvents")
    if not remoteFolder then
        remoteFolder = Instance.new("Folder")
        remoteFolder.Name = "RemoteEvents"
        remoteFolder.Parent = ReplicatedStorage
        print("[MM2] Папка RemoteEvents создана.")
    end

    local events = {
        "UpdateRoleClient",
        "UpdateStatusClient",
        "MurdererKill",
        "SheriffShoot",
        "GunPickup"
    }

    for _, name in ipairs(events) do
        if not remoteFolder:FindFirstChild(name) then
            local event = Instance.new("RemoteEvent")
            event.Name = name
            event.Parent = remoteFolder
            print("[MM2] Создан RemoteEvent:", name)
        end
    end
    return remoteFolder
end

local RemoteEvents = EnsureRemoteEvents()

-- Получаем ссылки на события
local UpdateRoleClient = RemoteEvents:FindFirstChild("UpdateRoleClient")
local UpdateStatusClient = RemoteEvents:FindFirstChild("UpdateStatusClient")
local MurdererKill = RemoteEvents:FindFirstChild("MurdererKill")
local SheriffShoot = RemoteEvents:FindFirstChild("SheriffShoot")
local GunPickup = RemoteEvents:FindFirstChild("GunPickup")

if not (UpdateRoleClient and UpdateStatusClient and MurdererKill and SheriffShoot and GunPickup) then
    error("[MM2] Не удалось создать все RemoteEvents! Проверьте доступ к ReplicatedStorage.")
end

-- ============================================================================
-- 2. КОНФИГУРАЦИЯ (можно менять под свои нужды)
-- ============================================================================
local CONFIG = {
    ROUND_DURATION = 180,          -- длительность раунда (сек)
    LOBBY_TIME = 10,               -- время между раундами (сек)
    MIN_PLAYERS = 3,               -- минимальное кол-во игроков для старта
    SHERIFF_AMMO = 6,              -- патронов у шерифа
    SCORE_WIN = 10,                -- очков за победу
    SCORE_KILL = 5,                -- очков за убийство (убийце)
    TAGS = {
        KNIFE = "Knife",
        GUN = "Gun",
        SHERIFF_GUN = "SheriffGun",
    }
}

-- Возможность загрузить внешний конфиг из ModuleScript
local ConfigModule = ReplicatedStorage:FindFirstChild("Config")
if ConfigModule and ConfigModule:IsA("ModuleScript") then
    local userConfig = require(ConfigModule)
    for key, value in pairs(userConfig) do
        CONFIG[key] = value
    end
end

-- ============================================================================
-- 3. ХРАНИЛИЩА ДАННЫХ И СОСТОЯНИЕ
-- ============================================================================
local PlayerData = {}          -- данные каждого игрока
local GameState = {
    RoundActive = false,
    RoundTimer = nil,
    LobbyTimer = nil,
    Murderer = nil,
    Sheriff = nil,
    Innocents = {},
    GunDropped = false,
    GunModel = nil,
}

-- ============================================================================
-- 4. ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
-- ============================================================================
local function GetCharacter(player)
    if not player then return nil end
    local char = player.Character
    if not char or not char.Parent then return nil end
    return char
end

local function GetAlivePlayers()
    local alive = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if PlayerData[plr] and PlayerData[plr].Alive then
            table.insert(alive, plr)
        end
    end
    return alive
end

local function IsMurderer(player)
    return GameState.Murderer == player
end

local function IsSheriff(player)
    return GameState.Sheriff == player
end

-- ============================================================================
-- 5. МОДУЛЬ УПРАВЛЕНИЯ РОЛЯМИ
-- ============================================================================
local RoleManager = {}

function RoleManager.AssignRoles()
    local players = Players:GetPlayers()
    if #players < CONFIG.MIN_PLAYERS then
        warn("[MM2] Недостаточно игроков для назначения ролей.")
        return false
    end

    -- Перемешиваем
    for i = #players, 2, -1 do
        local j = math.random(i)
        players[i], players[j] = players[j], players[i]
    end

    -- Очистка старых ролей
    GameState.Murderer = nil
    GameState.Sheriff = nil
    GameState.Innocents = {}

    -- Назначение
    GameState.Murderer = players[1]
    GameState.Sheriff = players[2]
    for i = 3, #players do
        table.insert(GameState.Innocents, players[i])
    end

    -- Инициализация данных
    for _, plr in ipairs(players) do
        if not PlayerData[plr] then
            PlayerData[plr] = { Score = 0 }
        end
        PlayerData[plr].Alive = true
        PlayerData[plr].Ammo = 0
        PlayerData[plr].IsMurderer = false
        PlayerData[plr].IsSheriff = false
    end

    if GameState.Murderer then
        PlayerData[GameState.Murderer].Role = "Murderer"
        PlayerData[GameState.Murderer].IsMurderer = true
    end
    if GameState.Sheriff then
        PlayerData[GameState.Sheriff].Role = "Sheriff"
        PlayerData[GameState.Sheriff].IsSheriff = true
        PlayerData[GameState.Sheriff].Ammo = CONFIG.SHERIFF_AMMO
    end
    for _, innocent in ipairs(GameState.Innocents) do
        PlayerData[innocent].Role = "Innocent"
    end

    -- Отправка ролей клиентам
    for _, plr in ipairs(players) do
        UpdateRoleClient:FireClient(plr, PlayerData[plr].Role)
        print(string.format("[MM2] %s → %s", plr.Name, PlayerData[plr].Role))
    end

    return true
end

-- ============================================================================
-- 6. МОДУЛЬ УПРАВЛЕНИЯ РАУНДАМИ
-- ============================================================================
local RoundManager = {}

function RoundManager.StartRound()
    if GameState.RoundActive then
        warn("[MM2] Раунд уже активен.")
        return
    end

    if #Players:GetPlayers() < CONFIG.MIN_PLAYERS then
        UpdateStatusClient:FireAllClients("Ожидание игроков...")
        return
    end

    -- Сброс состояния
    GameState.RoundActive = true
    GameState.GunDropped = false
    GameState.GunModel = nil
    GameState.RoundTimer = tick() + CONFIG.ROUND_DURATION

    -- Назначение ролей
    local success = RoleManager.AssignRoles()
    if not success then
        GameState.RoundActive = false
        return
    end

    -- Выдача оружия
    RoundManager.SpawnWeapons()
    UpdateStatusClient:FireAllClients("Раунд начался!")
    print("[MM2] Раунд стартовал, длительность:", CONFIG.ROUND_DURATION, "сек.")
end

function RoundManager.EndRound(winner)
    if not GameState.RoundActive then return end
    GameState.RoundActive = false
    GameState.RoundTimer = nil

    RoundManager.ClearWeapons()

    -- Начисление очков
    if winner == "Murderer" and GameState.Murderer then
        PlayerData[GameState.Murderer].Score = (PlayerData[GameState.Murderer].Score or 0) + CONFIG.SCORE_WIN
        UpdateStatusClient:FireAllClients("🔪 Убийца победил!")
        print("[MM2] Убийца", GameState.Murderer.Name, "победил.")
    elseif winner == "Innocents" then
        for _, plr in ipairs(GameState.Innocents) do
            if PlayerData[plr] then
                PlayerData[plr].Score = (PlayerData[plr].Score or 0) + CONFIG.SCORE_WIN
            end
        end
        if GameState.Sheriff then
            PlayerData[GameState.Sheriff].Score = (PlayerData[GameState.Sheriff].Score or 0) + CONFIG.SCORE_WIN
        end
        UpdateStatusClient:FireAllClients("👮 Невиновные победили!")
        print("[MM2] Невиновные победили.")
    else
        UpdateStatusClient:FireAllClients("⏰ Время вышло!")
        print("[MM2] Раунд завершён по таймауту.")
    end

    -- Запуск лобби
    GameState.LobbyTimer = tick() + CONFIG.LOBBY_TIME
    UpdateStatusClient:FireAllClients(string.format("Следующий раунд через %d сек...", CONFIG.LOBBY_TIME))
    print("[MM2] Раунд завершён.")
end

function RoundManager.SpawnWeapons()
    -- Нож убийце
    if GameState.Murderer then
        local char = GetCharacter(GameState.Murderer)
        if char then
            local knife = Instance.new("Tool")
            knife.Name = CONFIG.TAGS.KNIFE
            knife.RequiresHandle = false
            knife.Parent = char
        end
    end
    -- Пистолет шерифу
    if GameState.Sheriff then
        local char = GetCharacter(GameState.Sheriff)
        if char then
            local gun = Instance.new("Tool")
            gun.Name = CONFIG.TAGS.SHERIFF_GUN
            gun.RequiresHandle = false
            gun.Parent = char
        end
    end
end

function RoundManager.ClearWeapons()
    for _, plr in ipairs(Players:GetPlayers()) do
        local char = GetCharacter(plr)
        if char then
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") and (tool.Name == CONFIG.TAGS.KNIFE or tool.Name == CONFIG.TAGS.SHERIFF_GUN or tool.Name == CONFIG.TAGS.GUN) then
                    tool:Destroy()
                end
            end
        end
    end
    if GameState.GunModel then
        GameState.GunModel:Destroy()
        GameState.GunModel = nil
    end
    GameState.GunDropped = false
end

function RoundManager.DropGun(player)
    if GameState.GunDropped then return end
    local char = GetCharacter(player)
    if not char then return end
    local gunModel = Instance.new("Part")
    gunModel.Name = CONFIG.TAGS.GUN
    gunModel.Size = Vector3.new(1, 1, 2)
    gunModel.Position = char.PrimaryPart.Position + Vector3.new(0, 0, 2)
    gunModel.Anchored = true
    gunModel.Parent = workspace
    GameState.GunModel = gunModel
    GameState.GunDropped = true
    print("[MM2] Оружие выпало на землю.")
end

-- ============================================================================
-- 7. ОБРАБОТЧИКИ СОБЫТИЙ ОТ КЛИЕНТОВ
-- ============================================================================

-- Убийца убивает
MurdererKill.OnServerEvent:Connect(function(player, targetPlayer)
    if not GameState.RoundActive then return end
    if not IsMurderer(player) then return end
    if not targetPlayer or not PlayerData[targetPlayer] or not PlayerData[targetPlayer].Alive then return end

    PlayerData[targetPlayer].Alive = false
    PlayerData[player].Score = (PlayerData[player].Score or 0) + CONFIG.SCORE_KILL
    print(string.format("[MM2] %s убил %s", player.Name, targetPlayer.Name))

    local alive = GetAlivePlayers()
    if #alive <= 1 then
        RoundManager.EndRound("Murderer")
    end
end)

-- Шериф стреляет
SheriffShoot.OnServerEvent:Connect(function(player, targetPlayer)
    if not GameState.RoundActive then return end
    if not IsSheriff(player) then return end
    if not PlayerData[player] or PlayerData[player].Ammo <= 0 then return end

    PlayerData[player].Ammo = PlayerData[player].Ammo - 1

    if not targetPlayer then
        print(string.format("[MM2] %s промахнулся.", player.Name))
        return
    end
    if not PlayerData[targetPlayer] or not PlayerData[targetPlayer].Alive then return end

    if IsMurderer(targetPlayer) then
        PlayerData[targetPlayer].Alive = false
        print(string.format("[MM2] %s застрелил убийцу %s", player.Name, targetPlayer.Name))
        RoundManager.EndRound("Innocents")
    else
        PlayerData[targetPlayer].Alive = false
        print(string.format("[MM2] %s застрелил невиновного %s", player.Name, targetPlayer.Name))
        RoundManager.DropGun(player)
    end
end)

-- Поднятие оружия
GunPickup.OnServerEvent:Connect(function(player)
    if not GameState.RoundActive then return end
    if not GameState.GunDropped or not GameState.GunModel then return end
    if not PlayerData[player] or not PlayerData[player].Alive then return end

    local char = GetCharacter(player)
    if char then
        local gun = Instance.new("Tool")
        gun.Name = CONFIG.TAGS.GUN
        gun.RequiresHandle = false
        gun.Parent = char
        GameState.GunModel:Destroy()
        GameState.GunModel = nil
        GameState.GunDropped = false
        print(string.format("[MM2] %s поднял оружие и стал героем!", player.Name))
    end
end)

-- ============================================================================
-- 8. ОБРАБОТКА ВХОДА/ВЫХОДА ИГРОКОВ
-- ============================================================================
Players.PlayerAdded:Connect(function(player)
    PlayerData[player] = { Score = 0, Alive = true, Role = nil, Ammo = 0, IsMurderer = false, IsSheriff = false }
    print("[MM2] Игрок добавлен:", player.Name)
    if not GameState.RoundActive and #Players:GetPlayers() >= CONFIG.MIN_PLAYERS then
        RoundManager.StartRound()
    end
end)

Players.PlayerRemoving:Connect(function(player)
    PlayerData[player] = nil
    if GameState.RoundActive then
        if GameState.Murderer == player or GameState.Sheriff == player then
            RoundManager.EndRound(nil)
        end
    end
    print("[MM2] Игрок удалён:", player.Name)
end)

-- ============================================================================
-- 9. ОСНОВНОЙ ЦИКЛ (Heartbeat)
-- ============================================================================
RunService.Heartbeat:Connect(function()
    -- Таймер раунда
    if GameState.RoundActive and GameState.RoundTimer then
        local timeLeft = GameState.RoundTimer - tick()
        if timeLeft <= 0 then
            RoundManager.EndRound(nil)
        elseif timeLeft <= 10 then
            UpdateStatusClient:FireAllClients(string.format("⏳ Осталось %d сек!", math.ceil(timeLeft)))
        end
    end

    -- Таймер лобби
    if not GameState.RoundActive and GameState.LobbyTimer then
        local timeLeft = GameState.LobbyTimer - tick()
        if timeLeft <= 0 then
            GameState.LobbyTimer = nil
            if #Players:GetPlayers() >= CONFIG.MIN_PLAYERS then
                RoundManager.StartRound()
            else
                UpdateStatusClient:FireAllClients("Ожидание игроков...")
                GameState.LobbyTimer = tick() + CONFIG.LOBBY_TIME
            end
        end
    end

    -- Проверка жизни убийцы
    if GameState.RoundActive and GameState.Murderer then
        if not PlayerData[GameState.Murderer] or not PlayerData[GameState.Murderer].Alive then
            RoundManager.EndRound("Innocents")
        end
    end
    -- Если шериф умер – оружие выпадает
    if GameState.RoundActive and GameState.Sheriff then
        if not PlayerData[GameState.Sheriff] or not PlayerData[GameState.Sheriff].Alive then
            if not GameState.GunDropped then
                RoundManager.DropGun(GameState.Sheriff)
            end
        end
    end
end)

-- ============================================================================
-- 10. ЭКСПОРТ (для вызова из консоли или других скриптов)
-- ============================================================================
local MM2Core = {
    StartRound = RoundManager.StartRound,
    EndRound = RoundManager.EndRound,
    GetGameState = function() return GameState end,
    GetPlayerData = function(player) return PlayerData[player] end,
}
return MM2Core

