-- === ESP И CHAMS ===
local espObjects = {}
local chamsObjects = {}

function updateESP()
    if not espEnabled then return end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local head = player.Character.Head
            if not head:FindFirstChild("ESP_Billboard") then
                local bill = Instance.new("BillboardGui")
                bill.Name = "ESP_Billboard"
                bill.Parent = head
                bill.Size = UDim2.new(0, 120, 0, 50)
                bill.Adornee = head
                bill.AlwaysOnTop = true
                bill.StudsOffset = Vector3.new(0, 2, 0)
                bill.MaxDistance = 500

                local label = Instance.new("TextLabel")
                label.Parent = bill
                label.Size = UDim2.new(1, 0, 0.6, 0)
                label.BackgroundTransparency = 1
                label.Text = player.Name
                label.TextScaled = true
                label.Font = Enum.Font.GothamBold
                label.TextColor3 = Color3.fromRGB(255, 255, 255)
                label.TextStrokeTransparency = 0.3

                local roleLabel = Instance.new("TextLabel")
                roleLabel.Parent = bill
                roleLabel.Size = UDim2.new(1, 0, 0.4, 0)
                roleLabel.Position = UDim2.new(0, 0, 0.6, 0)
                roleLabel.BackgroundTransparency = 1
                roleLabel.Text = getPlayerRole(player)
                roleLabel.TextScaled = true
                roleLabel.Font = Enum.Font.Gotham
                roleLabel.TextColor3 = Color3.fromRGB(200, 200, 200)

                espObjects[player] = bill
            end
            local role = getPlayerRole(player)
            local color = role == "Murderer" and Color3.fromRGB(255, 0, 0) or
                         role == "Sheriff" and Color3.fromRGB(0, 100, 255) or
                         Color3.fromRGB(0, 255, 0)
            local label = espObjects[player]:FindFirstChild("TextLabel")
            if label then label.TextColor3 = color end
        end
    end
end

function clearESP()
    for player, bill in pairs(espObjects) do
        if bill and bill.Parent then bill:Destroy() end
    end
    espObjects = {}
end

function updateChams()
    if not chamsEnabled then return end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            if not char:FindFirstChild("ChamsHighlight") then
                local hl = Instance.new("Highlight")
                hl.Name = "ChamsHighlight"
                hl.Parent = char
                hl.Adornee = char
                hl.FillColor = Color3.fromRGB(255, 255, 255)
                hl.FillTransparency = 0.6
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.OutlineTransparency = 0.2
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                chamsObjects[player] = hl
            end
            local role = getPlayerRole(player)
            local color = role == "Murderer" and Color3.fromRGB(255, 0, 0) or
                         role == "Sheriff" and Color3.fromRGB(0, 100, 255) or
                         Color3.fromRGB(0, 255, 0)
            local hl = chamsObjects[player]
            hl.FillColor = color
            hl.OutlineColor = color
        end
    end
end

function clearChams()
    for player, hl in pairs(chamsObjects) do
        if hl and hl.Parent then hl:Destroy() end
    end
    chamsObjects = {}
end

