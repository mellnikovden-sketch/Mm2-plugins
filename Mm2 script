-- Переключение вкладок
local function switchTab(tabName)
    for _, child in pairs(ContentFrame:GetChildren()) do
        if child:IsA("Frame") then
            child.Visible = (child.Name == tabName)
        end
    end
    -- Обновляем стиль кнопок
    for name, btn in pairs(tabButtons) do
        btn.BackgroundColor3 = (name == tabName) and Color3.fromRGB(70, 70, 100) or Color3.fromRGB(40, 40, 60)
        btn.TextColor3 = (name == tabName) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)
    end
    currentTab = tabName
end

for name, btn in pairs(tabButtons) do
    btn.MouseButton1Click:Connect(function()
        switchTab(name)
    end)
end
switchTab("Aimbot")

-- Обновление CanvasSize для прокрутки
local function updateCanvas()
    local maxHeight = 0
    for _, child in pairs(ContentFrame:GetChildren()) do
        if child:IsA("Frame") and child.Visible then
            local frame = child
            local children = frame:GetChildren()
            local lastY = 0
            for _, c in pairs(children) do
                if c:IsA("Frame") then
                    local pos = c.Position.Y.Offset
                    if pos + 35 > lastY then lastY = pos + 35 end
                end
            end
            if lastY > maxHeight then maxHeight = lastY end
        end
    end
    ContentFrame.CanvasSize = UDim2.new(0, 0, 0, maxHeight + 10)
end
-- Просто обновляем при каждом переключении
local originalSwitch = switchTab
switchTab = function(tab)
    originalSwitch(tab)
    task.wait(0.1)
    updateCanvas()
end
-- Изначально
task.wait(0.1)
updateCanvas()

-- === Основные функции ===

-- ESP
local espObjects = {}
local function updateESP()
    if not espEnabled then return end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local head = player.Character.Head
            if not head:FindFirstChild("ESP_Billboard") then
                local bill = Instance.new("BillboardGui")
                bill.Name = "ESP_Billboard"
                bill.Parent = head
                bill.Size = UDim2.new(0, 80, 0, 30)
                bill.Adornee = head
                bill.AlwaysOnTop = true

                local label = Instance.new("TextLabel")
                label.Parent = bill
                label.Size = UDim2.new(1, 0, 1, 0)
                label.BackgroundTransparency = 1
                label.Text = player.Name
                label.TextScaled = true
                label.Font = Enum.Font.GothamBold
                label.TextColor3 = Color3.fromRGB(255, 255, 255)
                label.TextStrokeTransparency = 0.3

                local roleLabel = Instance.new("TextLabel")
                roleLabel.Parent = bill
                roleLabel.Size = UDim2.new(1, 0, 0.5, 0)
                roleLabel.Position = UDim2.new(0, 0, 0.6, 0)
                roleLabel.BackgroundTransparency = 1
                roleLabel.Text = getPlayerRole(player)
                roleLabel.TextScaled = true
                roleLabel.Font = Enum.Font.Gotham
                roleLabel.TextColor3 = Color3.fromRGB(200, 200, 200)

                espObjects[player] = bill
            end
            -- Обновляем цвет в зависимости от роли
            local role = getPlayerRole(player)
            local color = role == "Murderer" and Color3.fromRGB(255, 0, 0) or
                         role == "Sheriff" and Color3.fromRGB(0, 100, 255) or
                         Color3.fromRGB(0, 255, 0)
            local label = espObjects[player]:FindFirstChild("TextLabel")
            if label then label.TextColor3 = color end
        end
    end
end

local function clearESP()
    for player, bill in pairs(espObjects) do
        if bill and bill.Parent then bill:Destroy() end
    end
    espObjects = {}
end

-- Chams
local chamsObjects = {}
local function updateChams()
    if not chamsEnabled then return end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            if not char:FindFirstChild("ChamsHighlight") then
                local hl = Instance.new("Highlight")
                hl.Name = "ChamsHighlight"
                hl.Parent = char
                hl.Adornee = char
                hl.FillColor = Color3.fromRGB(255, 255, 255)
                hl.FillTransparency = 0.5
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.OutlineTransparency = 0.2
                chamsObjects[player] = hl
            end
            -- Обновляем цвет по роли
            local role = getPlayerRole(player)
            local color = role == "Murderer" and Color3.fromRGB(255, 0, 0) or
                         role == "Sheriff" and Color3.fromRGB(0, 100, 255) or
                         Color3.fromRGB(0, 255, 0)
            local hl = chamsObjects[player]
            hl.FillColor = color
            hl.OutlineColor = color
        end
    end
end

local function clearChams()
    for player, hl in pairs(chamsObjects) do
        if hl and hl.Parent then hl:Destroy() end
    end
    chamsObjects = {}
end

-- Обработка появления/исчезновения игроков
Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        if espEnabled then updateESP() end
        if chamsEnabled then updateChams() end
    end)
end)
Players.PlayerRemoving:Connect(function(player)
    if espObjects[player] then espObjects[player]:Destroy(); espObjects[player] = nil end
    if chamsObjects[player] then chamsObjects[player]:Destroy(); chamsObjects[player] = nil end
end)

-- === Silent Aim + Auto Shoot ===
RunService.RenderStepped:Connect(function()
    -- Silent Aim
    if silentAim then
        local murderer = getMurderer()
        if murderer and murderer.Character and murderer.Character:FindFirstChild("Head") then
            local head = murderer.Character.Head
            if isVisible(head) then
                local targetPos = head.Position
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
            end
        end
    end

    -- Auto Shoot
    if autoShoot then
        local murderer = getMurderer()
        if murderer and murderer.Character and murderer.Character:FindFirstChild("Head") then
            local head = murderer.Character.Head
            if isVisible(head) then
                -- Проверяем, находится ли цель в центре экрана (примерно)
                local screenPoint, onScreen = Camera:WorldToScreenPoint(head.Position)
                if onScreen then
                    local mousePos = UserInputService:GetMouseLocation()
                    local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePos).Magnitude
                    if dist < 150 then -- радиус прицела
                        if shootRemote then
                            shootRemote:FireServer(head.Position)
                        end
                    end
                end
            end
        end
    end

    -- Auto Farm (сбор монет)
    if farmEnabled then
        for _, coin in pairs(workspace:GetChildren()) do
            if coin:IsA("Part") and coin.Name:lower():find("coin") then
                if collectCoinRemote then
                    collectCoinRemote:FireServer(coin)
                end
            end
        end
    end
end)

-- Обновление ESP и Chams каждые несколько секунд (для динамических изменений)
task.spawn(function()
    while true do
        task.wait(1)
        if espEnabled then updateESP() end
        if chamsEnabled then updateChams() end
    end
end)

