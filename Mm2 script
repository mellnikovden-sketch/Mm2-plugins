-- Функции для определения ролей
local function findMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            if p.Backpack:FindFirstChild("Knife") or (p.Character and p.Character:FindFirstChild("Knife")) then
                return p
            end
        end
    end
    return nil
end

local function findSheriff()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            if p.Backpack:FindFirstChild("Gun") or (p.Character and p.Character:FindFirstChild("Gun")) then
                return p
            end
        end
    end
    return nil
end

-- ESP система
local espHighlights = {}

local function updatePlayerESP()
    if not espPlayersEnabled then
        for _, h in pairs(espHighlights) do
            h:Destroy()
        end
        espHighlights = {}
        return
    end

    for p, h in pairs(espHighlights) do
        if not p.Parent or not p.Character then
            h:Destroy()
            espHighlights[p] = nil
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local highlight = espHighlights[p]
            if not highlight then
                highlight = Instance.new("Highlight")
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                highlight.Adornee = p.Character
                highlight.Parent = p.Character
                espHighlights[p] = highlight
            else
                highlight.Adornee = p.Character
            end

            if p == findMurderer() then
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
            elseif p == findSheriff() then
                highlight.FillColor = Color3.fromRGB(0, 100, 255)
                highlight.OutlineColor = Color3.fromRGB(0, 100, 255)
            else
                highlight.FillColor = Color3.fromRGB(0, 255, 0)
                highlight.OutlineColor = Color3.fromRGB(0, 255, 0)
            end
            highlight.Enabled = true
        end
    end
end

-- ESP Gun (Dropped Gun)
local gunHighlight = nil
local function updateGunESP()
    if not espGunEnabled then
        if gunHighlight then gunHighlight:Destroy() gunHighlight = nil end
        return
    end

    local map = workspace:FindFirstChild("Map") or workspace:FindFirstChild("Game") or workspace
    local gunDrop = map:FindFirstChild("GunDrop")
    if gunDrop then
        if not gunHighlight then
            gunHighlight = Instance.new("Highlight")
            gunHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            gunHighlight.FillColor = Color3.fromRGB(255, 255, 0)
            gunHighlight.OutlineColor = Color3.fromRGB(255, 255, 0)
            gunHighlight.Parent = gunDrop
        else
            gunHighlight.Adornee = gunDrop
        end
        gunHighlight.Enabled = true
    else
        if gunHighlight then gunHighlight:Destroy() gunHighlight = nil end
    end
end

local function refreshESP()
    updatePlayerESP()
    updateGunESP()
end

-- События обновления
Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function()
        refreshESP()
    end)
    refreshESP()
end)

Players.PlayerRemoving:Connect(function()
    refreshESP()
end)

workspace.DescendantAdded:Connect(function(child)
    if child.Name == "GunDrop" then refreshESP() end
end)
workspace.DescendantRemoved:Connect(function(child)
    if child.Name == "GunDrop" then refreshESP() end
end)

