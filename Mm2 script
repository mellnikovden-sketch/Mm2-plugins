-- Silent Aim
RunService.Heartbeat:Connect(function()
    if silentAimEnabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                -- Проверка на убийцу (MM2 логика)
                if plr:FindFirstChild("Murderer") or plr:FindFirstChild("IsMurderer") then
                    local target = plr.Character.HumanoidRootPart.Position
                    -- Наведение прицела
                    local cam = workspace.CurrentCamera
                    local direction = (target - cam.CFrame.Position).Unit
                    cam.CFrame = CFrame.lookAt(cam.CFrame.Position, target)
                end
            end
        end
    end
end)

-- Aimbot (ищет убийцу)
local function findMurderer()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            -- Проверка на убийцу
            if plr:FindFirstChild("Murderer") or plr:FindFirstChild("IsMurderer") then
                return plr
            end
        end
    end
    return nil
end

RunService.Heartbeat:Connect(function()
    if aimbotEnabled then
        local murderer = findMurderer()
        if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
            local target = murderer.Character.HumanoidRootPart.Position
            local cam = workspace.CurrentCamera
            local direction = (target - cam.CFrame.Position).Unit
            cam.CFrame = CFrame.lookAt(cam.CFrame.Position, target)
        end
    end
end)

-- ESP
local function updateESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local highlight = plr.Character:FindFirstChild("Highlight")
            if espEnabled then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Parent = plr.Character
                end
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                highlight.FillTransparency = 0.5
                highlight.OutlineColor = Color3.fromRGB(0, 255, 0)
                
                -- Разный цвет для убийцы
                if plr:FindFirstChild("Murderer") or plr:FindFirstChild("IsMurderer") then
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                else
                    highlight.FillColor = Color3.fromRGB(0, 150, 255)
                end
            else
                if highlight then
                    highlight:Destroy()
                end
            end
        end
    end
end

RunService.Heartbeat:Connect(updateESP)

-- Wallhack
RunService.Heartbeat:Connect(function()
    if wallhackEnabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character then
                for _, part in ipairs(plr.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Transparency = 0.3
                    end
                end
            end
        end
    end
end)

-- Godmode
RunService.Heartbeat:Connect(function()
    if godModeEnabled and player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.Health = 100
        player.Character.Humanoid.MaxHealth = 100
    end
end)

-- Auto Knife (автобросок в убийцу)
RunService.Heartbeat:Connect(function()
    if autoKnifeEnabled then
        local murderer = findMurderer()
        if murderer and murderer.Character then
            local tool = player.Character:FindFirstChildOfClass("Tool")
            if tool and tool.Name:find("Knife") then
                tool:Activate()
                task.wait(0.1)
            end
        end
    end
end)

-- Auto Murderer (автоматически находит убийцу)
RunService.Heartbeat:Connect(function()
    if autoMurdererEnabled then
        local murderer = findMurderer()
        if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
            player.Character.HumanoidRootPart.CFrame = murderer.Character.HumanoidRootPart.CFrame + Vector3.new(0, 0, 5)
        end
    end
end)

