-- Кнопка Shoot Murderer
shootButton.MouseButton1Click:Connect(function()
    local sheriff = findSheriff()
    if sheriff ~= player then
        print("You are not the sheriff")
        return
    end
    local murderer = findMurderer()
    if not murderer then
        print("No murderer found")
        return
    end

    local gun = player.Character and player.Character:FindFirstChild("Gun")
    if not gun then
        gun = player.Backpack:FindFirstChild("Gun")
        if gun then
            player.Character.Humanoid:EquipTool(gun)
        else
            print("You don't have a gun")
            return
        end
    end

    local murdererHRP = murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart")
    if not murdererHRP then
        print("Murderer has no HumanoidRootPart")
        return
    end

    -- Попытка стрельбы через стандартное событие Shoot
    local shootEvent = player.Character:FindFirstChild("Gun") and player.Character.Gun:FindFirstChild("Shoot")
    if shootEvent then
        local origin = player.Character.HumanoidRootPart.Position
        local targetPos = murdererHRP.Position
        shootEvent:FireServer(CFrame.new(origin), CFrame.new(targetPos))
    else
        -- Альтернативный способ (через RemoteFunction)
        local gunRemote = player.Character:FindFirstChild("Gun") and player.Character.Gun:FindFirstChild("KnifeLocal") and player.Character.Gun.KnifeLocal:FindFirstChild("CreateBeam")
        if gunRemote then
            gunRemote:InvokeServer(1, murdererHRP.Position, "AH2")
        else
            print("Shoot event not found")
        end
    end
end)

