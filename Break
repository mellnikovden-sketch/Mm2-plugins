-- Автоматическая активация при обнаружении роли убийцы
local function checkMurdererRole()
    while wait(5) do
        -- Проверяем, есть ли у нас нож
        local hasKnife = false
        if localPlayer.Character then
            for _, tool in pairs(localPlayer.Character:GetChildren()) do
                if tool:IsA("Tool") and tool.Name:lower():find("knife") then
                    hasKnife = true
                    murder = localPlayer
                    break
                end
            end
        end
        
        -- Если мы убийца, можно автоматически активировать
        if hasKnife and not enabled then
            shared.Notify("⚠️ Обнаружен нож убийцы", 3)
        end
    end
end

-- Запускаем проверку роли
spawn(checkMurdererRole)
