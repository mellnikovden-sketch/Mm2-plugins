local shared = odh_shared_plugins
local players = game:GetService("Players")
local localPlayer = players.LocalPlayer
local runService = game:GetService("RunService")
local replicatedStorage = game:GetService("ReplicatedStorage")

local my_own_section = shared.AddSection("MM2 KNIFE BREAKER")

my_own_section:AddLabel("Ножной саботаж v1.0")
my_own_section:AddParagraph("Функции", "Ломает нож убийцы, предотвращая убийства")

-- Проверка игры
if game.PlaceId ~= 142823291 then
    shared.Notify("Этот плагин работает только в Murder Mystery 2!", 5)
    return
end

local enabled = false
local methods = {
    "RemoteEvent",    -- Блокировка удаленных событий
    "Tool",          -- Порча инструмента
    "AntiTarget",    -- Защита игроков
    "VisualBug"      -- Визуальный баг
}
local currentMethod = "RemoteEvent"

-- Поиск важных объектов игры
local knife = nil
local murder = nil
local gameModules = nil

-- Функция для поиска модулей игры
local function findGameModules()
    for _, module in pairs(replicatedStorage:GetDescendants()) do
        if module:IsA("ModuleScript") and module.Name:lower():find("murder") then
            gameModules = module
            break
        end
    end
    
    -- Поиск в других местах
    if not gameModules then
        for _, obj in pairs(game:GetDescendants()) do
            if obj:IsA("ModuleScript") and (obj.Name:lower():find("knife") or obj.Name:lower():find("murder")) then
                gameModules = obj
                break
            end
        end
    end
end

-- Метод 1: Блокировка RemoteEvent
local function blockRemotes()
    if not enabled then return end
    
    -- Поиск всех RemoteEvent связанных с ножом/убийством
    for _, obj in pairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local name = obj.Name:lower()
            if name:find("attack") or name:find("hit") or name:find("damage") or 
               name:find("kill") or name:find("stab") or name:find("murder") then
                -- Замена функции FireServer
                local originalFire = obj.FireServer
                obj.FireServer = function(self, ...)
                    if enabled then
                        shared.Notify("Атака заблокирована!", 2)
                        return nil
                    else
                        return originalFire(self, ...)
                    end
                end
            end
        elseif obj:IsA("RemoteFunction") then
            local name = obj.Name:lower()
            if name:find("attack") or name:find("kill") then
                -- Блокировка RemoteFunction
                local originalInvoke = obj.InvokeServer
                obj.InvokeServer = function(self, ...)
                    if enabled then
                        return false
                    else
                        return originalInvoke(self, ...)
                    end
                end
            end
        end
    end
end

-- Метод 2: Порча инструмента
local function corruptTool()
    if not enabled then return end
    
    -- Поиск ножа в инвентаре
    if localPlayer.Character then
        for _, tool in pairs(localPlayer.Character:GetChildren()) do
            if tool:IsA("Tool") and tool.Name:lower():find("knife") then
                knife = tool
                
                -- Удаляем или изменяем свойства ножа
                local handle = tool:FindFirstChild("Handle")
                if handle then
                    -- Делаем нож невидимым
                    handle.Transparency = 1
                    
                    -- Удаляем эффекты
                    for _, effect in pairs(handle:GetChildren()) do
                        if effect:IsA("ParticleEmitter") or effect:IsA("Beam") then
                            effect.Enabled = false
                        end
                    end
                end
                
                -- Находим и портим RemoteEvent в ноже
                for _, child in pairs(tool:GetChildren()) do
                    if child:IsA("RemoteEvent") then
                        child:Destroy()
                    end
                end
                
                -- Заменяем функцию Activate
                local originalActivate = tool.Activate
                tool.Activate = function(self, ...)
                    if enabled then
                        shared.Notify("Нож сломан - атака невозможна", 2)
                        return nil
                    else
                        return originalActivate(self, ...)
                    end
                end
            end
        end
    end
end

-- Метод 3: Защита всех игроков
local function protectPlayers()
    if not enabled then return end
    
    for _, player in pairs(players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if humanoid then
                -- Защита от урона
                humanoid.MaxHealth = math.huge
                humanoid.Health = math.huge
                
                -- Делаем игрока неуязвимым
                local forceField = Instance.new("ForceField")
                forceField.Parent = player.Character
                forceField.Visible = false
            end
        end
    end
end

-- Метод 4: Визуальный баг
local function createVisualBug()
    if not enabled then return end
    
    -- Создаем визуальный эффект "поломки" ножа
    if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local root = localPlayer.Character.HumanoidRootPart
        
        -- Эффект искр
        local sparks = Instance.new("Sparkles")
        sparks.Parent = root
        sparks.SparkleColor = Color3.fromRGB(255, 0, 0)
        
        -- Звук поломки (если возможно)
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://161124105" -- Звук поломки
        sound.Parent = root
        sound:Play()
        
        -- Сообщение в чат
        game:GetService("TextChatService").TextChannels.RBXGeneral:SendAsync("⚠️ Нож сломан! Убийства невозможны!")
    end
end

-- Toggle для включения
my_own_section:AddToggle("Активировать поломку ножа", function(bool)
    enabled = bool
    if bool then
        shared.Notify("Нож убийцы сломан!", 3)
        
        -- Запускаем выбранный метод
        if currentMethod == "RemoteEvent" then
            blockRemotes()
        elseif currentMethod == "Tool" then
            corruptTool()
        elseif currentMethod == "AntiTarget" then
            protectPlayers()
        elseif currentMethod == "VisualBug" then
            createVisualBug()
        end
        
        -- Постоянный мониторинг
        spawn(function()
            while enabled do
                wait(1)
                
                -- Обновляем защиту
                if currentMethod == "AntiTarget" then
                    protectPlayers()
                end
                
                -- Проверяем наличие ножа
                corruptTool()
            end
        end)
    else
        shared.Notify("Нож восстановлен", 2)
    end
end)

