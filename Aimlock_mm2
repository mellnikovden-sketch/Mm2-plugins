local function CreateRoundButton()
    if RoundButton then 
        RoundButton:Destroy() 
        RoundButton = nil
    end
    
    local colors = COLOR_PRESETS[CurrentColor] or COLOR_PRESETS.OBSIDIAN
    
    local parent = CoreGui
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then parent = playerGui end
    
    local button = Instance.new("ImageButton")
    button.Name = "AimLockRoundButton"
    button.Size = UDim2.new(0, 60, 0, 60)
    button.Position = UDim2.new(0.02, 0, 0.82, 0)
    button.BackgroundTransparency = 1
    button.Image = "rbxassetid://86221076925479"
    button.Parent = parent
    button.ZIndex = 10
    button.AutoButtonColor = false
    
    -- Обводка
    local stroke = Instance.new("UIStroke")
    stroke.Color = AimLockEnabled and colors.statusActive or colors.border
    stroke.Thickness = 2.5
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = button
    
    local strokeGrad = Instance.new("UIGradient")
    strokeGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, colors.accent),
        ColorSequenceKeypoint.new(0.5, colors.border),
        ColorSequenceKeypoint.new(1, colors.accent)
    })
    strokeGrad.Rotation = 0
    strokeGrad.Parent = stroke
    
    -- Текст внутри (ON/OFF)
    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = AimLockEnabled and "ON" or "OFF"
    text.TextColor3 = colors.text
    text.TextSize = 16
    text.Font = Enum.Font.Jura
    text.TextWrapped = true
    text.Parent = button
    
    -- Анимация вращения
    local rotConn = RunService.RenderStepped:Connect(function()
        if strokeGrad and strokeGrad.Parent then
            strokeGrad.Rotation = (strokeGrad.Rotation + 0.5) % 360
        end
    end)
    ButtonMaid:GiveTask(rotConn)
    
    -- Клик - переключение AimLock
    button.MouseButton1Click:Connect(function()
        AimLockEnabled = not AimLockEnabled
        if AimLockEnabled then 
            TargetPlayer = FindMurderer(nil) 
            text.Text = "ON"
            stroke.Color = colors.statusActive
        else 
            TargetPlayer = nil 
            text.Text = "OFF"
            stroke.Color = colors.border
        end
        if _G.UpdateAimUI then _G.UpdateAimUI() end
    end)
    
    -- Перетаскивание
    local dragging = false
    local dragStart = nil
    local startPos = nil
    
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = button.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    button.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
            local delta = input.Position - dragStart
            local parentSize = button.Parent.AbsoluteSize
            button.Position = UDim2.new(
                startPos.X.Scale + (delta.X / parentSize.X),
                0,
                startPos.Y.Scale + (delta.Y / parentSize.Y),
                0
            )
        end
    end)
    
    RoundButton = button
    ButtonMaid:GiveTask(button)
    
    return button
end

