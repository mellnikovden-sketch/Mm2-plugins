    RunService:UnbindFromRenderStep("MM2_AimLock_PhaseSync")
    if SettingsMenu then SettingsMenu:Destroy() end
    if RoundButton then RoundButton:Destroy() end
    if MenuButton then MenuButton:Destroy() end
end)

