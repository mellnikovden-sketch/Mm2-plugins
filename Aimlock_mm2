local function ToggleSettingsMenu()
    if not SettingsMenu then
        CreateSettingsMenu()
        if SettingsMenu then
            MenuOpen = true
            SettingsMenu.Visible = true
        end
    else
        MenuOpen = not MenuOpen
        SettingsMenu.Visible = MenuOpen
    end
end

