    predBtn.Position = UDim2.new(0.75, 0, 0.15, 0)
    predBtn.BackgroundColor3 = colors.accent
    predBtn.BackgroundTransparency = 0.3
    predBtn.Text = levels[predIdx]
    predBtn.TextColor3 = colors.text
    predBtn.TextSize = 12
    predBtn.Font = Enum.Font.Jura
    predBtn.Parent = predRow
    
    local predCorner = Instance.new("UICorner")
    predCorner.CornerRadius = UDim.new(0, 4)
    predCorner.Parent = predBtn
    
    predBtn.MouseButton1Click:Connect(function()
        predIdx = predIdx % 4 + 1
        predBtn.Text = levels[predIdx]
        if predIdx == 1 then PredictionLevel = 0.08
        elseif predIdx == 2 then PredictionLevel = 0.145
        elseif predIdx == 3 then PredictionLevel = 0.2
        else PredictionLevel = 0 end
    end)
    
    -- ===== TAB 3: COLORS =====
    local tab3 = Instance.new("Frame")
    tab3.Size = UDim2.new(1, 0, 1, 0)
    tab3.BackgroundTransparency = 1
    tab3.Visible = false
    tab3.Parent = contentArea
    table.insert(contentFrames, tab3)
    
    local colorY = 10
    local colorKeys = {}
    for key, _ in pairs(COLOR_PRESETS) do
        table.insert(colorKeys, key)
    end
    
    for i, key in ipairs(colorKeys) do
        local preset = COLOR_PRESETS[key]
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 30)
        row.Position = UDim2.new(0, 0, 0, colorY)
        row.BackgroundTransparency = 1
        row.Parent = tab3
        
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0.9, 0, 1, 0)
        btn.Position = UDim2.new(0.05, 0, 0, 0)
        btn.BackgroundColor3 = preset.bg
        btn.BackgroundTransparency = 0.3
        btn.Text = preset.name
        btn.TextColor3 = preset.text
        btn.TextSize = 11
        btn.Font = Enum.Font.Jura
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = row
        
        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 4)
        btnCorner.Parent = btn
        
        -- Color preview dot
        local dot = Instance.new("Frame")
        dot.Size = UDim2.new(0, 12, 0, 12)
        dot.Position = UDim2.new(0.9, 0, 0.5, -6)
        dot.BackgroundColor3 = preset.border
        dot.BorderSizePixel = 0
        dot.Parent = btn
        
        local dotCorner = Instance.new("UICorner")
        dotCorner.CornerRadius = UDim.new(1, 0)
        dotCorner.Parent = dot
        
        -- Checkmark for current
        if CurrentColor == key then
            local check = Instance.new("TextLabel")
            check.Size = UDim2.new(0, 20, 1, 0)
            check.Position = UDim2.new(0.8, 0, 0, 0)
            check.BackgroundTransparency = 1
            check.Text = "✔"
            check.TextColor3 = preset.accent
            check.TextSize = 14
            check.Font = Enum.Font.Jura
            check.Parent = btn
        end
        
        btn.MouseButton1Click:Connect(function()
            CurrentColor = key
            if MainMenu then MainMenu:Destroy() end
            if RoundButton then RoundButton:Destroy() end
            CreateRoundButton()
            CreateOverdriveMenu()
            MenuOpen = true
            if MainMenu then MainMenu.Visible = true end
        end)
        
        colorY = colorY + 35
    end
    
    -- ===== TAB 4: STATS =====
    local tab4 = Instance.new("Frame")
    tab4.Size = UDim2.new(1, 0, 1, 0)
    tab4.BackgroundTransparency = 1
    tab4.Visible = false
    tab4.Parent = contentArea
    table.insert(contentFrames, tab4)
    
    local statsData = {
        {"🎯 Status", AimLockEnabled and "Active" or "Inactive"},
        {"🎯 Target", TargetPlayer and TargetPlayer.Name or "None"},
        {"📶 Ping", math.floor(LocalPlayer:GetNetworkPing() * 1000) .. "ms"},
        {"🧱 WallCheck", WallCheckEnabled and "ON" or "OFF"},
        {"⚡ Prediction", tostring(PredictionLevel)},
        {"🎨 Color", COLOR_PRESETS[CurrentColor].name}
    }
    
    local statY = 10
    for _, data in ipairs(statsData) do
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 30)
        row.Position = UDim2.new(0, 0, 0, statY)
        row.BackgroundTransparency = 1
        row.Parent = tab4
        
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.4, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = data[1]
        label.TextColor3 = colors.text
        label.TextSize = 12
        label.Font = Enum.Font.Jura
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = row
        
        local value = Instance.new("TextLabel")
        value.Size = UDim2.new(0.4, 0, 1, 0)
        value.Position = UDim2.new(0.5, 0, 0, 0)
        value.BackgroundTransparency = 1
        value.Text = data[2]
        value.TextColor3 = colors.accent
        value.TextSize = 12
        value.Font = Enum.Font.Jura
        value.TextXAlignment = Enum.TextXAlignment.Right
        value.Parent = row
        
        statY = statY + 35
    end
    
    -- Bottom bar
    local bottomBar = Instance.new("Frame")
    bottomBar.Size = UDim2.new(1, 0, 0, 35)
    bottomBar.Position = UDim2.new(0, 0, 1, -35)
    bottomBar.BackgroundColor3 = colors.bgTitle
    bottomBar.BackgroundTransparency = 0.3
    bottomBar.BorderSizePixel = 0
    bottomBar.Parent = frame
    
    local versionLabel = Instance.new("TextLabel")
    versionLabel.Size = UDim2.new(1, 0, 1, 0)
    versionLabel.BackgroundTransparency = 1
    versionLabel.Text = "AIMLOCK PRO v2.6 | Hard Lock"
    versionLabel.TextColor3 = colors.text
    versionLabel.TextSize = 10
    versionLabel.Font = Enum.Font.Jura
    versionLabel.TextTransparency = 0.5
    versionLabel.Parent = bottomBar
    
    MainMenu = frame
    return frame
end

