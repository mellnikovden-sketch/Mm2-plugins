        setTitle.Size = UDim2.new(1, 0, 0, 30)
        setTitle.BackgroundColor3 = colors.bgTitle
        setTitle.BackgroundTransparency = 0.3
        setTitle.Text = "⚙ SETTINGS"
        setTitle.TextColor3 = colors.accent
        setTitle.TextSize = 13
        setTitle.Font = Enum.Font.Jura
        setTitle.Parent = settingsFrame
        
        local closeBtn = Instance.new("TextButton")
        closeBtn.Size = UDim2.new(0, 25, 0, 25)
        closeBtn.Position = UDim2.new(1, -28, 0, 2)
        closeBtn.BackgroundTransparency = 1
        closeBtn.Text = "✕"
        closeBtn.TextColor3 = colors.text
        closeBtn.TextSize = 14
        closeBtn.Font = Enum.Font.Jura
        closeBtn.Parent = settingsFrame
        closeBtn.MouseButton1Click:Connect(function()
            settingsFrame:Destroy()
        end)
        
        local options = {
            {text = "🎯 Head", pos = 35, value = "Head"},
            {text = "🎯 Torso", pos = 52, value = "HumanoidRootPart"},
            {text = "🧱 WallCheck", pos = 69, value = "wallcheck"},
            {text = "⚡ Prediction", pos = 86, value = "prediction"}
        }
        
        for _, opt in ipairs(options) do
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(0.6, 0, 0, 16)
            label.Position = UDim2.new(0.05, 0, 0, opt.pos)
            label.BackgroundTransparency = 1
            label.Text = opt.text
            label.TextColor3 = colors.text
            label.TextSize = 10
            label.Font = Enum.Font.Jura
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = settingsFrame
            
            if opt.value == "wallcheck" then
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(0.25, 0, 0, 16)
                btn.Position = UDim2.new(0.7, 0, 0, opt.pos)
                btn.BackgroundColor3 = WallCheckEnabled and colors.statusActive or colors.statusPaused
                btn.BackgroundTransparency = 0.3
                btn.Text = WallCheckEnabled and "ON" or "OFF"
                btn.TextColor3 = colors.text
                btn.TextSize = 9
                btn.Font = Enum.Font.Jura
                btn.Parent = settingsFrame
                
                local btnCorner = Instance.new("UICorner")
                btnCorner.CornerRadius = UDim.new(0, 2)
                btnCorner.Parent = btn
                
                btn.MouseButton1Click:Connect(function()
                    WallCheckEnabled = not WallCheckEnabled
                    btn.Text = WallCheckEnabled and "ON" or "OFF"
                    btn.BackgroundColor3 = WallCheckEnabled and colors.statusActive or colors.statusPaused
                end)
            elseif opt.value == "prediction" then
                local levels = {"Low", "Medium", "High", "Off"}
                local currentIdx = 3
                if PredictionLevel == 0.08 then currentIdx = 1
                elseif PredictionLevel == 0.145 then currentIdx = 2
                elseif PredictionLevel == 0 then currentIdx = 4 end
                
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(0.25, 0, 0, 16)
                btn.Position = UDim2.new(0.7, 0, 0, opt.pos)
                btn.BackgroundColor3 = colors.accent
                btn.BackgroundTransparency = 0.3
                btn.Text = levels[currentIdx]
                btn.TextColor3 = colors.text
                btn.TextSize = 9
                btn.Font = Enum.Font.Jura
                btn.Parent = settingsFrame
                
                local btnCorner = Instance.new("UICorner")
                btnCorner.CornerRadius = UDim.new(0, 2)
                btnCorner.Parent = btn
                
                btn.MouseButton1Click:Connect(function()
                    currentIdx = currentIdx % 4 + 1
                    btn.Text = levels[currentIdx]
                    if currentIdx == 1 then PredictionLevel = 0.08
                    elseif currentIdx == 2 then PredictionLevel = 0.145
                    elseif currentIdx == 3 then PredictionLevel = 0.2
                    else PredictionLevel = 0 end
                end)
            else
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(0.25, 0, 0, 16)
                btn.Position = UDim2.new(0.7, 0, 0, opt.pos)
                btn.BackgroundColor3 = colors.accent
                btn.BackgroundTransparency = 0.3
                btn.Text = TargetPart == opt.value and "✔" or "○"
                btn.TextColor3 = colors.text
                btn.TextSize = 12
                btn.Font = Enum.Font.Jura
                btn.Parent = settingsFrame
                
                local btnCorner = Instance.new("UICorner")
                btnCorner.CornerRadius = UDim.new(0, 2)
                btnCorner.Parent = btn
                
                btn.MouseButton1Click:Connect(function()
                    TargetPart = opt.value
                    for _, child in ipairs(settingsFrame:GetChildren()) do
                        if child:IsA("TextButton") and child.Text == "✔" or child.Text == "○" then
                            child.Text = child == btn and "✔" or "○"
                        end
                    end
                end)
            end
        end
        
        -- Color selector
        local colorLabel = Instance.new("TextLabel")
        colorLabel.Size = UDim2.new(0.6, 0, 0, 16)
        colorLabel.Position = UDim2.new(0.05, 0, 0, 103)
        colorLabel.BackgroundTransparency = 1
        colorLabel.Text = "🎨 Color"
        colorLabel.TextColor3 = colors.text
        colorLabel.TextSize = 10
        colorLabel.Font = Enum.Font.Jura
        colorLabel.TextXAlignment = Enum.TextXAlignment.Left
        colorLabel.Parent = settingsFrame
        
        local colorBtn = Instance.new("TextButton")
        colorBtn.Size = UDim2.new(0.25, 0, 0, 16)
        colorBtn.Position = UDim2.new(0.7, 0, 0, 103)
        colorBtn.BackgroundColor3 = colors.accent
        colorBtn.BackgroundTransparency = 0.3
        colorBtn.Text = COLOR_PRESETS[CurrentColor].name
        colorBtn.TextColor3 = colors.text
        colorBtn.TextSize = 8
        colorBtn.Font = Enum.Font.Jura
        colorBtn.Parent = settingsFrame
        
        local colorCorner = Instance.new("UICorner")
        colorCorner.CornerRadius = UDim.new(0, 2)
        colorCorner.Parent = colorBtn
        
        local colorIndex = 0
        local colorKeys = {}
        for key, _ in pairs(COLOR_PRESETS) do
            table.insert(colorKeys, key)
        end
        
        colorBtn.MouseButton1Click:Connect(function()
            colorIndex = (colorIndex % #colorKeys) + 1
            local newColor = colorKeys[colorIndex]
            CurrentColor = newColor
            colorBtn.Text = COLOR_PRESETS[newColor].name
            -- Recreate GUI
            if _G.AimGui then _G.AimGui:Destroy() end
            CreateAimGUI()
            settingsFrame:Destroy()
        end)
        
        -- Close button at bottom
        local closeBottom = Instance.new("TextButton")
        closeBottom.Size = UDim2.new(0.8, 0, 0, 20)
        closeBottom.Position = UDim2.new(0.1, 0, 0, 125)
        closeBottom.BackgroundColor3 = colors.border
        closeBottom.BackgroundTransparency = 0.3
        closeBottom.Text = "CLOSE"
        closeBottom.TextColor3 = colors.text
        closeBottom.TextSize = 10
        closeBottom.Font = Enum.Font.Jura
        closeBottom.Parent = settingsFrame
        
        local closeCorner = Instance.new("UICorner")
        closeCorner.CornerRadius = UDim.new(0, 3)
        closeCorner.Parent = closeBottom
        
        closeBottom.MouseButton1Click:Connect(function()
            settingsFrame:Destroy()
        end)
    end)
    
    -- Update function for info
    local function UpdateGUIInfo()
        if not _G.AimGui then return end
        if AimLockEnabled then
            infoLabels[2].Text = "📶 Ping: " .. math.floor(LocalPlayer:GetNetworkPing() * 1000) .. "ms"
            infoLabels[1].Text = "🎯 Target: " .. (TargetPlayer and TargetPlayer.Name or "Searching...")
        end
    end
    
    _G.UpdateAimGUI = UpdateGUIInfo
    
    UpdateAimButton()
    
    return gui
end

