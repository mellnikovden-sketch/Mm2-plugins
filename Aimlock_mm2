-- Обновление статистики
local function UpdateStats()
    if MainMenu and MainMenu.Visible then
        -- Обновляем статистику на вкладке Stats
        local tab4 = MainMenu:FindFirstChildWhichIsA("Frame"):FindFirstChildWhichIsA("Frame")
        if tab4 then
            local frames = {}
            for _, child in ipairs(tab4:GetChildren()) do
                if child:IsA("Frame") then
                    table.insert(frames, child)
                end
            end
            if #frames >= 6 then
                local vals = {}
                for _, f in ipairs(frames) do
                    for _, c in ipairs(f:GetChildren()) do
                        if c:IsA("TextLabel") and c.TextXAlignment == Enum.TextXAlignment.Right then
                            table.insert(vals, c)
                        end
                    end
                end
                if #vals >= 6 then
                    vals[1].Text = AimLockEnabled and "Active" or "Inactive"
                    vals[2].Text = TargetPlayer and TargetPlayer.Name or "None"
                    vals[3].Text = math.floor(LocalPlayer:GetNetworkPing() * 1000) .. "ms"
                    vals[4].Text = WallCheckEnabled and "ON" or "OFF"
                    vals[5].Text = tostring(PredictionLevel)
                    vals[6].Text = COLOR_PRESETS[CurrentColor].name
                end
            end
        end
    end
end

RunService.Heartbeat:Connect(UpdateStats)

-- Очистка
LocalPlayer.CharacterAdded:Connect(function()
    TargetPlayer = nil
end)

RootMaid:GiveTask(function()
    RunService:UnbindFromRenderStep("MM2_AimLock_PhaseSync")
    if MainMenu then MainMenu:Destroy() end
    if RoundButton then RoundButton:Destroy() end
end)

