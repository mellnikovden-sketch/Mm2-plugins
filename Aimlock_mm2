local function UpdateAimButtonState()
    local btn = BindableButtons.Buttons["aim_toggle"]
    if not btn then return end
    BindableButtons.UpdateBButtonText("aim_toggle", AimLockEnabled and "Aim:ON" or "Aim:OFF")
    BindableButtons.UpdateBButtonColor("aim_toggle", AimLockEnabled, "aim")
end

local function ToggleAimLock()
    AimLockEnabled = not AimLockEnabled
    if AimLockEnabled then 
        TargetPlayer = FindMurderer(nil) 
    else 
        TargetPlayer = nil 
    end
    UpdateAimButtonState()
    print("⚡ Aim Lock: " .. (AimLockEnabled and "ENABLED" or "DISABLED"))
end

local function UpdateWallButtonState()
    local btn = BindableButtons.Buttons["wall_toggle"]
    if not btn then return end
    BindableButtons.UpdateBButtonText("wall_toggle", WallCheckEnabled and "Wall:ON" or "Wall:OFF")
    BindableButtons.UpdateBButtonColor("wall_toggle", WallCheckEnabled, "wall")
end

local function ToggleWallCheck()
    WallCheckEnabled = not WallCheckEnabled
    UpdateWallButtonState()
    print("🧱 Wall Check: " .. (WallCheckEnabled and "ENABLED" or "DISABLED"))
end

local function UpdateOutlineButtonState()
    local btn = BindableButtons.Buttons["outline_toggle"]
    if not btn then return end
    BindableButtons.UpdateBButtonText("outline_toggle", OutlineEnabled and "OL:ON" or "OL:OFF")
    BindableButtons.UpdateBButtonColor("outline_toggle", OutlineEnabled, "outline")
end

local function ToggleOutline()
    OutlineEnabled = not OutlineEnabled
    UpdateOutline()
    UpdateOutlineButtonState()
    print("👁️ Outline: " .. (OutlineEnabled and "ENABLED" or "DISABLED"))
end

local function CreateButtons()
    if not BindableButtons.Buttons["aim_toggle"] then
        BindableButtons.AddBButton("aim_toggle", "Aim:OFF", function()
            ToggleAimLock()
        end, false, "aim")
    end
    
    if not BindableButtons.Buttons["wall_toggle"] then
        BindableButtons.AddBButton("wall_toggle", "Wall:OFF", function()
            ToggleWallCheck()
        end, false, "wall")
    end
    
    if not BindableButtons.Buttons["outline_toggle"] then
        BindableButtons.AddBButton("outline_toggle", "OL:OFF", function()
            ToggleOutline()
        end, false, "outline")
    end    
    UpdateAimButtonState()
    UpdateWallButtonState()
    UpdateOutlineButtonState()
end

local function DeleteButtons()
    BindableButtons.DeleteBButton("aim_toggle")
    BindableButtons.DeleteBButton("wall_toggle")
    BindableButtons.DeleteBButton("outline_toggle")
end

local function ToggleButtonsVisibility()
    for _, id in ipairs({"aim_toggle", "wall_toggle", "outline_toggle"}) do
        local btn = BindableButtons.Buttons[id]
        if btn then
            btn.Visible = ShowBindableButton
        end
    end
end

