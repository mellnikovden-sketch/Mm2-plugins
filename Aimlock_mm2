local function ToggleMenu()
    if not MainMenu then
        CreateOverdriveMenu()
        if MainMenu then
            MenuOpen = true
            MainMenu.Visible = true
        end
    else
        MenuOpen = not MenuOpen
        MainMenu.Visible = MenuOpen
    end
end

