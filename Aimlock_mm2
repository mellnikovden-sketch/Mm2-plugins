-- Горячая клавиша T для тоггла AimLock
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.T then
        AimLockEnabled = not AimLockEnabled
        if AimLockEnabled then TargetPlayer = FindMurderer(nil) else TargetPlayer = nil end
        if RoundButton then
            local txt = RoundButton:FindFirstChildWhichIsA("TextLabel")
            if txt then txt.Text = AimLockEnabled and "ON" or "OFF" end
            local st = RoundButton:FindFirstChildWhichIsA("UIStroke")
            if st then 
                local colors = COLOR_PRESETS[CurrentColor]
                st.Color = AimLockEnabled and colors.statusActive or colors.border
            end
        end
        if _G.UpdateAimUI then _G.UpdateAimUI() end
    end
end)

