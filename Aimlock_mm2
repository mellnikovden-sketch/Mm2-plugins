-- Обновление UI
local function UpdateUI()
    if SettingsMenu and SettingsMenu.Visible then
        -- Обновляем статус в меню
        local tab1 = SettingsMenu:FindFirstChildWhichIsA("Frame"):FindFirstChildWhichIsA("Frame")
        if tab1 then
            for _, child in ipairs(tab1:GetChildren()) do
                if child:IsA("Frame") then
                    for _, c in ipairs(child:GetChildren()) do
                        if c:IsA("TextLabel") and c.TextXAlignment == Enum.TextXAlignment.Right then
                            if c.Text == "🟢 ACTIVE" or c.Text == "🔴 INACTIVE" then
                                c.Text = AimLockEnabled and "🟢 ACTIVE" or "🔴 INACTIVE"
                                local colors = COLOR_PRESETS[CurrentColor]
                                c.TextColor3 = AimLockEnabled and colors.statusActive or colors.statusPaused
                            end
                        end
                        if c:IsA("TextLabel") and string.find(c.Text or "", "Target:") then
                            c.Text = "🎯 Target: " .. (TargetPlayer and TargetPlayer.Name or "None")
                        end
                    end
                end
            end
        end
    end
end

RunService.Heartbeat:Connect(UpdateUI)

