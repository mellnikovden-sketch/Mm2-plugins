-- ==============================================
RunService:BindToRenderStep(
    "MM2_AimLock_PhaseSync", 
    Enum.RenderPriority.Camera.Value + 1, 
    AimLockLoop
)

-- Обновление GUI в цикле
RunService.Heartbeat:Connect(function()
    if _G.UpdateAimGUI then _G.UpdateAimGUI() end
end)

