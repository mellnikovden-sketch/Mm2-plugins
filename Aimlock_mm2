            for _, child in ipairs(tab2:GetDescendants()) do
                if child:IsA("TextButton") then
                    child.Text = (child == btn) and "✔" or "○"
                    child.BackgroundColor3 = (child == btn) and colors.statusActive or colors.bgTitle
                end
            end
        end)
        
        targetY = targetY + 40
    end
    
    -- Prediction
    local predRow = Instance.new("Frame")
    predRow.Size = UDim2.new(1, 0, 0, 35)
    predRow.Position = UDim2.new(0, 0, 0, targetY + 10)
    predRow.BackgroundTransparency = 1
    predRow.Parent = tab2
    
    local predLabel = Instance.new("TextLabel")
    predLabel.Size = UDim2.new(0.5, 0, 1, 0)
    predLabel.BackgroundTransparency = 1
    predLabel.Text = "⚡ Prediction"
    predLabel.TextColor3 = colors.text
    predLabel.TextSize = 13
    predLabel.Font = Enum.Font.Jura
    predLabel.TextXAlignment = Enum.TextXAlignment.Left
    predLabel.Parent = predRow
    
    local levels = {"Low", "Medium", "High", "Off"}
    local predIdx = 3
    if PredictionLevel == 0.08 then predIdx = 1
    elseif PredictionLevel == 0.145 then predIdx = 2
    elseif PredictionLevel == 0 then predIdx = 4 end
    
    local predBtn = Instance.new("TextButton")
    predBtn.Size = UDim2.new(0.3, 0, 0.7, 0)
    predBtn.Position = UDim2.new(0.7, 0, 0.15, 0)
    predBtn.BackgroundColor3 = colors.accent
    predBtn.BackgroundTransparency = 0.3
    predBtn.Text = levels[predIdx]
    predBtn.TextColor3 = colors.text
    predBtn.TextSize = 12
    predBtn.Font = Enum.Font.Jura
    predBtn.Parent = predRow
    
    local predCorner = Instance.new("UICorner")
    predCorner.CornerRadius = UDim.new(0, 4)
    predCorner.Parent = predBtn
    
    predBtn.MouseButton1Click:Connect(function()
        predIdx = predIdx % 4 + 1
        predBtn.Text = levels[predIdx]
        if predIdx == 1 then PredictionLevel = 0.08
        elseif predIdx == 2 then PredictionLevel = 0.145
        elseif predIdx == 3 then PredictionLevel = 0.2
        else PredictionLevel = 0 end
    end)
    
    -- ===== TAB 3: COLORS =====
    local tab3 = Instance.new("Frame")
    tab3.Size = UDim2.new(1, 0, 1, 0)
    tab3.BackgroundTransparency = 1
    tab3.Visible = false
    tab3.Parent = contentArea
    table.insert(contentFrames, tab3)
    
    local colorY = 10
    local colorKeys = {}
    for key, _ in pairs(COLOR_PRESETS) do
        table.insert(colorKeys, key)
    end
    
    for i, key in ipairs(colorKeys) do
        local preset = COLOR_PRESETS[key]
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 30)
        row.Position = UDim2.new(0, 0, 0, colorY)
        row.BackgroundTransparency = 1
        row.Parent = tab3
        
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0.9, 0, 1, 0)
        btn.Position = UDim2.new(0.05, 0, 0, 0)
        btn.BackgroundColor3 = preset.bg
        btn.BackgroundTransparency = 0.3
        btn.Text = preset.name
        btn.TextColor3 = preset.text
        btn.TextSize = 11
        btn.Font = Enum.Font.Jura
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = row
        
        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 4)
        btnCorner.Parent = btn
        
        -- Color preview dot
        local dot = Instance.new("Frame")
        dot.Size = UDim2.new(0, 12, 0, 12)
        dot.Position = UDim2.new(0.9, 0, 0.5, -6)
        dot.BackgroundColor3 = preset.border
        dot.BorderSizePixel = 0
        dot.Parent = btn
        
        local dotCorner = Instance.new("UICorner")
        dotCorner.CornerRadius = UDim.new(1, 0)
        dotCorner.Parent = dot
        
        -- Checkmark for current
        if CurrentColor == key then
            local check = Instance.new("TextLabel")
            check.Size = UDim2.new(0, 20, 1, 0)
            check.Position = UDim2.new(0.8, 0, 0, 0)
            check.BackgroundTransparency = 1
            check.Text = "✔"
            check.TextColor3 = preset.accent
            check.TextSize = 14
            check.Font = Enum.Font.Jura
            check.Parent = btn
        end
        
        btn.MouseButton1Click:Connect(function()
            CurrentColor = key
            -- Пересоздаём всё с новым цветом
            if RoundButton then RoundButton:Destroy() end
            if MenuButton then MenuButton:Destroy() end
            if SettingsMenu then SettingsMenu:Destroy() end
            CreateRoundButton()
            CreateMenuButton()
            CreateSettingsMenu()
            if MenuOpen then
                SettingsMenu.Visible = true
            end
        end)
        
        colorY = colorY + 35
    end
    
    SettingsMenu = frame
    return frame
end

